# Copia este archivo a .env (que no se sube a git) antes de levantar la app:
#   cp seguro/.env.example seguro/.env
# Todo esto es local y de mentira: no son secretos reales.

POSTGRES_DB=demo
POSTGRES_USER=demo
POSTGRES_PASSWORD=clave_de_demo

# SEGURO V03: en la versión buena, el secreto de la pasarela vive aquí (en el
# entorno), no en el código. Sigue siendo falso.
API_KEY_PASARELA=sk-FALSO-pagos-9c8b7a6d5e4f3210

# pgAdmin rechaza dominios reservados como .local: usa uno con formato válido (aunque sea falso).
