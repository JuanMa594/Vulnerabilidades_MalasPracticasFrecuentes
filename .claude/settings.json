{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(rtk git status)",
      "Bash(rtk git diff *)",
      "Bash(rtk git log *)",
      "Bash(rtk docker compose ps)",
      "Bash(rtk docker compose config)",
      "Bash(rtk docker compose logs *)",
      "Bash(rtk uv sync)",
      "Bash(rtk uv run ruff *)",
      "Bash(rtk uv run ty *)",
      "Bash(rtk uv run pytest *)"
    ],
    "ask": [
      "Bash(rtk docker compose down *)",
      "Bash(rtk docker volume rm *)",
      "Bash(rtk git push *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Edit(**/.env)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(rtk pip *)",
      "Bash(python -m pip *)",
      "Bash(poetry *)"
    ]
  }
}
